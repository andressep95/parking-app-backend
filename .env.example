# =============================================================================
# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore — nunca lo subas al repositorio.
# =============================================================================

# AWS — credenciales del IAM user parking-app-backend
# Policy acotada solo al User Pool us-east-1_5Hq8VEHuN
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# PostgreSQL (Docker Compose local)
DB_USERNAME=parking_user
DB_PASSWORD=parking_pass
